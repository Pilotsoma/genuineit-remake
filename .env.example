# ---- Build-time (Next.js) ----
# Public origin used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://genuineitllc.com
# Endpoint the inquiry forms POST to. Defaults to the bundled PHP handler.
NEXT_PUBLIC_FORM_ENDPOINT=/api/inquiry.php

# ---- Runtime (PHP handler: public/api/inquiry.php) ----
# Set these as real server environment variables (Apache SetEnv in a non-public
# vhost config, or the hosting control panel). Never commit real values.
# MAIL_TRANSPORT: "resend" (HTTPS API), "sendmail" (PHP mail()), or empty = disabled.
MAIL_TRANSPORT=
RESEND_API_KEY=
# Verified sender address, e.g. "GenuineIT Website <web@genuineitllc.com>"
MAIL_FROM=
# Where inquiries are delivered
MAIL_TO_GENERAL=info@genuineitllc.com
MAIL_TO_CAREERS=careers@genuineitllc.com
# Writable directory outside the web root for rate-limit counters
RATE_LIMIT_DIR=/tmp/genuineit-ratelimit
