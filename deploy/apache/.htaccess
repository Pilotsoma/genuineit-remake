# =============================================================================
# GenuineIT website — Apache configuration (generated by scripts/generate-redirects.mjs)
# Deploy alongside the static export in out/. Requires mod_rewrite and mod_headers.
# =============================================================================
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host + HTTPS (enable once TLS is confirmed on the host) ---------
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\.genuineitllc\.com$ [NC]
  # RewriteRule ^ https://genuineitllc.com%{REQUEST_URI} [R=301,L]

  # --- Legacy URL redirects (301) ---------------------------------------------
  RewriteRule ^index\.php$ / [R=301,L]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^company\-profile\.php$ /company/about/ [R=301,L]
  RewriteRule ^mission\.php$ /company/mission-values/ [R=301,L]
  RewriteRule ^it\-services\.php$ /company/clients-partners/ [R=301,L]
  RewriteRule ^clients\.php$ /company/clients-partners/ [R=301,L]
  RewriteRule ^testimonials\.php$ /company/testimonials/ [R=301,L]
  RewriteRule ^employees\.php$ /resources/employees/ [R=301,L]
  RewriteRule ^careers\.php$ /careers/ [R=301,L]
  RewriteRule ^git\-domestic\-career\.php$ /careers/ [R=301,L]
  RewriteRule ^lca\.php$ /compliance/lca/ [R=301,L]
  RewriteRule ^engaging\-with\-us\.php$ /contact/business-inquiries/ [R=301,L]
  RewriteRule ^partnering\-us\.php$ /contact/partnerships/ [R=301,L]
  RewriteRule ^contact\.php$ /contact/ [R=301,L]
  RewriteRule ^disclaimer\.php$ /legal/disclaimer/ [R=301,L]
  RewriteRule ^images/lca_docs/I\-200\-24157\-07185\.pdf$ /images/lca_docs/I-200-24157-071855.pdf [R=301,L]
  RewriteRule ^professional\-services\.php$ /services/professional-services/ [R=301,L]
  RewriteRule ^training\.php$ /services/training/ [R=301,L]
  RewriteRule ^it\-out\-sourcing\.php$ /services/it-outsourcing/ [R=301,L]
  RewriteRule ^change\-mgmnt\.php$ /services/change-management/ [R=301,L]
  RewriteRule ^enterprise\-architecture\.php$ /services/enterprise-architecture/ [R=301,L]
  RewriteRule ^bpm\-mgmnt\-services\.php$ /services/bpm-services/ [R=301,L]
  RewriteRule ^program\-mgmnt\-support\.php$ /services/program-management-support/ [R=301,L]
  RewriteRule ^business\-process\-outsourcing\.php$ /services/business-process-outsourcing/ [R=301,L]
  RewriteRule ^application\-development\.php$ /services/application-development/ [R=301,L]
  RewriteRule ^application\-integration\.php$ /services/application-integration/ [R=301,L]
  RewriteRule ^web\-app\-development\.php$ /services/web-application-development/ [R=301,L]
  RewriteRule ^soa\-services\.php$ /services/soa-services/ [R=301,L]
  RewriteRule ^product\-development\.php$ /services/product-development/ [R=301,L]
  RewriteRule ^product\-management\.php$ /services/product-management/ [R=301,L]
  RewriteRule ^prototyping\.php$ /services/prototyping/ [R=301,L]
  RewriteRule ^sustenance\-eng\.php$ /services/sustenance-engineering/ [R=301,L]
  RewriteRule ^quality\-assurance\.php$ /services/quality-assurance/ [R=301,L]
  RewriteRule ^cloud\-services\.php$ /services/cloud-services/ [R=301,L]
  RewriteRule ^configuration\-mgmnt\.php$ /services/configuration-management/ [R=301,L]
  RewriteRule ^data\-mgmnt\.php$ /services/data-management/ [R=301,L]
  RewriteRule ^network\-operation\-center\.php$ /services/network-operations-center/ [R=301,L]
  RewriteRule ^production\-support\.php$ /services/production-support/ [R=301,L]
  RewriteRule ^legacy\-sw\-migration\.php$ /services/legacy-software-migration/ [R=301,L]
  RewriteRule ^application\-server\-sw\-migration\.php$ /services/application-server-migration/ [R=301,L]
  RewriteRule ^android\-appln\-development\.php$ /services/android-development/ [R=301,L]
  RewriteRule ^iphone\-app\-dev\.php$ /services/iphone-development/ [R=301,L]
  RewriteRule ^blackberry\-app\-dev\.php$ /services/blackberry-development/ [R=301,L]
  RewriteRule ^windows\-app\-dev\.php$ /services/windows-mobile-development/ [R=301,L]
  RewriteRule ^e\-learning\.php$ /services/e-learning/ [R=301,L]
  RewriteRule ^oracle\-app\-expertise\.php$ /solutions/oracle-applications/ [R=301,L]
  RewriteRule ^sap\.php$ /solutions/sap/ [R=301,L]
  RewriteRule ^microsoft\-dynamics\.php$ /solutions/microsoft-dynamics/ [R=301,L]
  RewriteRule ^salesforce\-crm\.php$ /solutions/salesforce-crm/ [R=301,L]
  RewriteRule ^siebel\.php$ /solutions/siebel-crm/ [R=301,L]
  RewriteRule ^content\-mgmt\-solution\.php$ /solutions/content-management/ [R=301,L]
  RewriteRule ^share\-point\-consulting\.php$ /solutions/sharepoint/ [R=301,L]
  RewriteRule ^business\-intelligence\-data\-warehousing\.php$ /solutions/business-intelligence/ [R=301,L]
  RewriteRule ^ecommerce\.php$ /solutions/ecommerce/ [R=301,L]
  RewriteRule ^utilities\.php$ /industries/energy-utilities/ [R=301,L]
  RewriteRule ^oil\-gas\.php$ /industries/oil-gas/ [R=301,L]
  RewriteRule ^manufacturing\.php$ /industries/manufacturing/ [R=301,L]
  RewriteRule ^defence\.php$ /industries/defense/ [R=301,L]
  RewriteRule ^banking\.php$ /industries/banking/ [R=301,L]
  RewriteRule ^insurance\.php$ /industries/insurance/ [R=301,L]
  RewriteRule ^health\-care\.php$ /industries/health-care/ [R=301,L]
  RewriteRule ^pharmaceauticals\.php$ /industries/pharma-life-sciences/ [R=301,L]
  RewriteRule ^government\.php$ /industries/government/ [R=301,L]
  RewriteRule ^transportation\.php$ /industries/transportation/ [R=301,L]
  RewriteRule ^communications\.php$ /industries/communications/ [R=301,L]
  RewriteRule ^retails\.php$ /industries/retail/ [R=301,L]

  # --- Retired legacy endpoints ------------------------------------------------
  RewriteRule ^captcha\.php$ - [G,L]
  # NOTE: /gitdocs/ (legacy sign-in area) is intentionally left untouched.
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Next.js static export inlines its bootstrap scripts, so 'unsafe-inline' is required for scripts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # Enable after HTTPS is verified on every subdomain:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Only the inquiry handler may be executed from /api/.
<If "%{REQUEST_URI} =~ m#^/api/# && %{REQUEST_URI} !~ m#^/api/inquiry\.php$#">
  Require all denied
</If>
